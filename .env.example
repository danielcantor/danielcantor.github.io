# Copiá este archivo como .env y completá los valores.

# Endpoint que recibe el formulario de contacto (Web3Forms).
VITE_FORM_ENDPOINT=https://api.web3forms.com/submit

# Access key de Web3Forms (https://web3forms.com). Es pública: solo permite
# enviar mensajes a tu casilla.
VITE_WEB3FORMS_KEY=

# ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin Analytics.
VITE_GA_ID=

# ID de proyecto de Microsoft Clarity (https://clarity.microsoft.com). Vacío = sin Clarity.
VITE_CLARITY_ID=
